།", "head": "ཚུལ་ཁྲིམས་འདི་ནི་བདེ་བའི་མཆོག །", "tail": "མིག་གི་འབྲས་བུ་བཞིན་དུ་སྲུངས། །"}, {"label": "QUOTE", "frame": "འཕགས་པ་གནས་འཇོག་གི་མདོ་ལས། ... བཀའ་སྩལ་པ།", "head": "གནས་འཇོག་རིགས་ཀྱི་བུའམ་རིགས་", "tail": "བསོད་ནམས་མང་ངོ་ཞེས་བྱ་བའི་གྲངས་སུ་འགྲོའོ། །"}, {"label": "QUOTE", "head": "གནས་འཇོག་འདི་ལ་འཕགས་པའི་", "tail": "ལྷ་དང་མི་རྣམས་ཀྱིས་འདོད་པ་ལ་ཡང་སྤྱད་པར་གྱིས་ཤིག་"}, {"label": "QUOTE", "frame": "ཀུན་ཏུ་རྒྱུ་སེན་རིངས་ཀྱིས་ཞུས་པ་ལས།", "head": "སྲོག་གཅོད་སྤངས་པས་རྡོ་རྗེའི་", "tail": "སེང་གེའི་སྟབས་སུ་གཤེགས་པར་གྱུར་པ་"}, {"label": "QUOTE", "frame": "དགེ་སློང་ལ་རབ་ཏུ་གཅེས་པའི་མདོ་ལས།", "head": "ལ་ལའི་ཚུལ་ཁྲིམས་བདེ་བ་སྟེ། །", "tail": "སྡིག་པའི་ལས་རྣམས་འཕེལ་བར་བཤད། །"}, {"label": "QUOTE", "head": "སྲོག་ལ་བབ་ཀྱང་ཚུལ་ཁྲིམས་ནི། །", "tail": "ཚུལ་ཁྲིམས་ཕྱི་ནས་དེ་ལྟ་མིན། །"}, {"label": "QUOTE", "frame": "འཕགས་པ་དགའ་བ་ཅན་གྱི་མདོ་ལས། ... བཀའ་སྩལ་པ།", "head": "དགའ་བ་ཅན་སྲོག་གཅོད་པའི་ཉེས་", "tail": "དེ་དག་ཡིན་པར་རིག་པར་བྱའོ། །"}, {"label": "QUOTE", "head": "བརྫུན་དུ་སྨྲ་བའི་ཉེས་དམིགས་", "tail": "སུམ་ཅུ་རྩ་ལྔ་པོ་དེ་དག་ཡིན་པར་རིག་པར་བྱའོ། །"}, {"label": "QUOTE", "head": "སྲོག་གཅོད་རྡེག་དང་འཆིང་བ་", "tail": "བསླབ་གཞིའི་ཆོས་ནི་རབ་ཏུ་བསྟན་པ་ཡིན། །"}, {"label": "QUOTE", "frame": "ཁང་བུ་བརྩེགས་པའི་མདོ་ལས། ... བཀའ་སྩལ་པ།", "head": "ཀུན་དགའ་བོ་གང་ལ་ལ་ཞིག་གིས་", "tail": "མཐའ་གཟུང་བར་མི་ནུས་པར་ང་སྨྲའོ། །"}, {"label": "QUOTE", "head": "ཀུན་དགའ་བོ་དེ་ལ་གང་གིས་ཉི་མ་", "tail": "མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་བྱེད་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "frame": "དྲི་མ་མེད་པའི་མདོ་ལས།", "head": "སྐྱབས་སུ་སོང་བའི་བསོད་ནམས་", "tail": "དེ་ནི་དེ་བས་ལྷག་པར་འགྱུར། །"}, {"label": "QUOTE", "frame": "དཀོན་བརྩེགས་ལས།", "head": "མི་གང་གསུམ་ལ་སྐྱབས་འགྲོ་བ། །", "tail": "ཆོས་དང་དགེ་འདུན་ཐོབ་པར་འགྱུར། །"}, {"label": "QUOTE", "frame": "གཏམ་བྱར།", "head": "སྐྱེས་བུ་གང་ཞིག་བྱང་ཆུབ་སེམས། །", "tail": "རྒྱལ་བ་ཡིས་ཀྱང་བགྲང་མི་སྤྱོད། །"}, {"label": "QUOTE", "frame": "དཔས་བྱིན་གྱིས་ཞུས་པའི་མདོ་ལས།", "head": "བྱང་ཆུབ་སེམས་ཀྱི་བསོད་ནམས་", "tail": "དེ་བས་ཀྱང་ནི་ལྷག་པར་འགྱུར། །"}, {"label": "QUOTE", "frame": "འདུལ་བ་ལུང་ལས།", "head": "ཚངས་སྤྱོད་ལེགས་པར་སྤྱོད་པ་", "tail": "འབར་བའི་ཁྱིམ་ནས་ཐར་པ་བཞིན། །"}, {"label": "QUOTE", "frame": "འཕགས་པ་དཀོན་མཆོག་བརྩེགས་པ་ལས།", "head": "དགེ་བ་དང་ནི་སྡིག་པའི་ཆོས། །", "tail": "ཚེ་འདི་ཉིད་ལ་མྱ་ངན་འདའ། །"}, {"label": "QUOTE", "frame": "ཐེག་པ་ཆེན་པོའི་མདོ་ལས། ... བཀའ་སྩལ་པ།", "head": "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་", "tail": "དཀོན་མཆོག་ལ་མཆོད་པར་བྱའོ། །"}, {"label": "QUOTE", "frame": "ཚེ་མཐའི་མདོ་ལས། ... བཀའ་སྩལ་པ།", "head": "དགེ་སློང་དག་ཁྱེད་སེམས་ཅན་", "tail": "སྡུག་བསྔལ་ཚོར་བ་རབ་ཏུ་མྱོང༌། །ཕན་ཚུན་ཕྲག་དོག་སེར་སྣ་འདི་བརྟེན་ཅིང༌། །འདིར་ནི་སྡིག་པའི་ལས་དག་བྱས་པ་ཡིས། །ཡི་དྭགས་འཇིག་རྟེན་དག་ཏུ་དེ་དག་སྐྱེས། །"}, {"label": "QUOTE", "head": "དབུལ་བས་སྡུག་བསྔལ་སེམས་ཅན་", "tail": "དེ་ནི་སྔོན་བྱིན་འབྲས་བུ་ཡིན། །"}, {"label": "QUOTE", "head": "བྱེ་བྲག་ཏུ་ལྷོ་འཛམ་བུའི་གླིང་", "tail": "ལས་དེ་ཡིས་ནི་ཐིག་ནག་གི། །དམྱལ་བ་རྣམས་སུ་དེ་དག་སྐྱེ། །"}, {"label": "QUOTE", "head": "མི་རྣམས་གྱིས་ལོ་ཉིས་བརྒྱ་", "tail": "ལས་དེ་དག་གིས་མནར་མེད་པའི། །དམྱལ་བ་དག་ཏུ་སྐྱེ་བར་འགྱུར། །"}, {"label": "QUOTE", "head": "གྲང་དམྱལ་རྣམས་ནི་འདི་ལྟ་", "tail": "དགེ་སློང་ཁྱེད་ཀྱིས་བསླབ་པར་བྱའོ། །"}, {"label": "QUOTE", "head": "མི་ཞིག་སྐྱེས་པར་གྱུར་པ་ན། །", "tail": "སྲིད་པ་མངོན་པར་བསྒྲུབ་པར་མི་བྱའོ། །"}, {"label": "QUOTE", "frame": "ཚེ་འཕོ་བ་ཇི་ལྟར་འགྱུར་བ་ཞུས་པའི་མདོ་ལས།", "head": "རྒྱལ་པོ་ཆེན་པོ་གང་དག་གིས་", "tail": "ལས་དང་ཉོན་མོངས་པ་སྔར་སྤྱོད་པའི་དབང་གིས་ཕྱིས་སྐྱེ་བ་ལེན་ནོ། །"}, {"label": "QUOTE", "frame": "འཕགས་པ་འདུ་ཤེས་བཅུ་གཅིག་བསྟན་པའི་མདོ་ལས། ... བཀའ་སྩལ་པ།", "head": "དགེ་སློང་དག་ནམ་འཆི་བའི་དུས་", "tail": "མྱ་ངན་ལས་འདས་པ་ནི་ཞི་བའོ་སྙམ་པའི་འདུ་ཤེས་མངོན་དུ་བྱའོ། །"}, {"label": "QUOTE", "frame": "འཕགས་པ་འདའ་དཀའ་ཡེ་ཤེས་ལས།", "head": "ཆོས་རྣམས་རང་བཞིན་རྣམ་དག་", "tail": "སངས་རྒྱས་གཞན་དུ་མ་ཚོལ་ཅིག །"}, {"label": "QUOTE", "frame": "དཀོན་མཆོག་བརྩེགས་པ་ལས།", "head": "ཅི་འདྲ་བ་ཡི་ལས་བྱས་པ། །", "tail": "དེ་ནི་ཅུང་ཟད་འགྱུར་བ་མེད། །"}, {"label": "QUOTE", "frame": "དྲན་པ་ཉེར་བཞག་ལས།", "head": "དགེ་བ་ཡིས་ནི་བདེ་བ་ཐོབ། །", "tail": "ལས་ཀྱི་འབྲས་བུ་གསལ་བར་སྟོན། །"}, {"label": "QUOTE", "frame": "དེས་པས་ཞུས་པའི་མདོ་ལས།", "head": "ས་བོན་ཚ་བ་རྣམས་ལས་ནི། །", "tail": "གཞན་དག་ལ་ཡང་ཡི་རང་བྱ། །"}, {"label": "QUOTE", "frame": "ཆེད་དུ་བརྗོད་པའི་ཚོམ་ལས།", "head": "སྡིག་པ་ཅི་ཡང་མི་བྱ་སྟེ། །", "tail": "དགེ་བས་བརྟན་པ་གང་བར་འགྱུར། །"}, {"label": "QUOTE", "frame": "སྐྱེས་རབས་ལས།", "head": "བདག་གི་ཕྱིར་དང་གཞན་གྱི་ཕྱིར་", "tail": "རྣམ་དག་མིག་གིས་མི་མཐོང་མི་སྲིད་དོ། །"}, {"label": "QUOTE", "frame": "བྱམས་པ་ལུང་བསྟན་པའི་མདོ་ལས།", "head": "གདུགས་དང་རྒྱལ་མཚན་བ་དན་དང༌། །", "tail": "ང་ཡི་བསྟན་ལ་ལྷགས་པ་ཡིན། །"}, {"label": "QUOTE", "frame": "འཕགས་པ་བརྒྱད་སྟོང་པ་ལས།", "head": "བཙུན་པ་ཤཱ་རིའི་བུ་དགེ་བའི་", "tail": "བར་མ་དོར་ཟད་ཅིང་མེད་པར་མི་འགྱུར་རོ། །"}, {"label": "QUOTE", "frame": "བྱམས་པས་ཞུས་པའི་མདོ་ལས།", "head": "དཔེར་ན་རྒྱ་མཚོ་ཆེན་པོར་ཆུ་", "tail": "རྒྱ་ཆེར་འཕེལ་བར་འགྱུར་རོ། །"}, {"label": "QUOTE", "frame": "གསང་ཆེན་ཐབས་ལ་མཁས་པའི་མདོ་ལས།", "head": "རིགས་ཀྱི་བུ་འདི་ལ་བྱང་ཆུབ་", "tail": "བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ཐབས་ལ་མཁས་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "frame": "རྒྱལ་པོ་ལ་གདམས་པའི་མདོ་ལས།", "head": "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ནི་འདི་", "tail": "བྱང་ཆུབ་ཀྱི་ཚོགས་ཀྱང་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ། །"}, {"label": "QUOTE", "frame": "བློ་གྲོས་མི་ཟད་པའི་མདོ་ལས།", "head": "གང་ཇི་ལྟར་དགེ་བའི་སེམས་སྐྱེས་", "tail": "བར་མ་དོར་ཡོངས་སུ་ཟད་པའམ་གཏུག་པར་འགྱུར་བ་གང་ཡང་མེད་དོ། །"}, {"label": "QUOTE", "frame": "ཆེད་དུ་བརྗོད་པའི་ཚོམ་ལས།", "head": "ཀྱེ་མ་འདུ་བྱེད་རྣམས་མི་རྟག །", "tail": "མི་རྣམས་སྲོག་ཀྱང་དེ་བཞིན་ནོ། །"}, {"label": "QUOTE", "head": "དཔེར་ན་ངེས་པར་གསོད་པ་དག །", "tail": "འཇིག་རྟེན་ཕལ་པས་འདོད་པ་སྤངས་རེ་སྐན། །"}, {"label": "QUOTE", "head": "རྒྱལ་པོའི་ཤིང་རྟ་ཤིན་ཏུ་བཀྲ་", "tail": "དགེ་སློང་དག་གོ་སྐྱེ་ཤིའི་ཕ་རོལ་འགྲོ་བར་གྱིས། །"}, {"label": "QUOTE", "frame": "མི་རྟག་པའི་མདོ་ལས།", "head": "ནད་མེད་མི་རྟག་ལང་ཚོ་རྟག་", "tail": "འདོད་པའི་ཡོན་ཏན་དགའ་བ་ཇི་ལྟར་སྐྱེ། །"}, {"label": "QUOTE", "frame": "དྲན་པ་ཉེར་བཞག་ལས།", "head": "འཆི་བདག་འཇིགས་པ་དྲན་པ་ནི། །", "tail": "ཐམས་ཅད་རྟག་ཏུ་ཞི་བར་འགྱུར། །"}, {"label": "QUOTE", "frame": "ཚོམ་ལས།", "head": "ངག་རྣམས་བསྲུང་ཞིང་ཡིད་ནི་", "tail": "དྲང་སྲོང་གསུངས་པའི་ལམ་ནི་ཐོབ་པར་འགྱུར། །"}, {"label": 