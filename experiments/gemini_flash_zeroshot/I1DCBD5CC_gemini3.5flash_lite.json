ad": "སེམས་ཉིད་གཅིག་པུ་ཀུན་", "tail": "ཡིད་བཞིན་ནོར་འདྲའི་སེམས་ལ་ཕྱག་འཚལ་ལོ། །\nཞེས་བརྗོད་ནས་"}, {"label": "QUOTE", "frame": "རྒྱུད་བླར།", "head": "སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་", "tail": "གློ་བུར་དྲི་མས་དེ་ཉོན་མོངས་མི་འགྱུར། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "རྒྱུད་བླར།", "head": "རིན་ཆེན་ནམ་མཁའ་ཆུ་དག་", "tail": "རྟག་ཏུ་རང་བཞིན་ཉོན་མོངས་མེད། །\nཅེས་གསུངས་པ་ལྟར་ཡིན།"}, {"label": "QUOTE", "frame": "མི་ལས་དྭགས་པོར།", "head": "ལྟ་བ་ཡིན་པར་ངེས་ཀྱི་", "tail": "གྱད་ཀྱིས་ནོར་འཚོལ་དང་འདྲའོ་ཨང་ངེ་ལྷ་རྗེ་སྟོན་པ་བ། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "རྒྱུད་བླར།", "head": "ཕྲ་ཕྱིར་ཐོས་པའི་ཡུལ་མིན་", "tail": "ཉི་མའི་གཟུགས་བཞིན་འཕགས་པས་ཀྱང་། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "རྒྱུད་བླར།", "head": "ངག་ཡུལ་མིན་ཕྱིར་དོན་དམ་", "tail": "རྒྱལ་ཡུལ་འཕགས་རྣམས་ཀྱིས་ཀྱང་བསམ་མི་ཁྱབ། །\nཅེས་གསུངས་པ་ལྟར་བསམ་གྱིས་མི་ཁྱབ་པ་ཡིན།"}, {"label": "QUOTE", "frame": "འཇུག་པར།", "head": "གང་ཕྱིར་དེ་ཡི་རང་བཞིན་", "tail": "ལུས་དང་ཡིད་ཀྱང་བསྙད་པར་བྱ། །\nཞེས་གསུངས་པ་ལྟར་ཡིན།"}, {"label": "QUOTE", "frame": "ལྷན་ཅིག་སྐྱེས་པའི་རྒྱུད་ལས།", "head": "སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་", "tail": "སྣང་སེམས་དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས་པའོ། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "ལྔ་ལྡན་དུ།", "head": "བླ་མ་སྐུ་བཞིའི་གངས་རི་", "tail": "སེམས་མོས་གུས་འདི་ལ་ནན་ཏན་མཛོད། །\nཅེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "རྗེ་རིན་པོ་ཆེའི་", "head": "སྣང་བ་རྟེན་འབྲེལ་བསླུ་བ་", "tail": "ད་དུང་ཐུབ་པའི་དགོངས་པ་རྟོགས་པ་མེད། །\nཇི་སྲིད་སོ་སོར་སྣང་བ་དེ་སྲིད་དུ་"}, {"label": "QUOTE", "frame": "རྗེ་རིན་པོ་ཆེའི་", "head": "ནམ་ཞིག་རེས་འཇོག་མེད་པར་", "tail": "དེ་ཚེ་ལྟ་བའི་དཔྱད་པ་རྫོགས་པ་ལགས། །\nཞེས་གསུངས་པ་བཞིན།"}, {"label": "QUOTE", "frame": "རྩ་ཤེར།", "head": "རྟེན་ཅིང་འབྲེལ་འབྱུང་མ་", "tail": "ཆོས་འགའ་ཡོད་པ་མ་ཡིན་ནོ། །\nཞེས་གསུངས་པ་ལྟར་ཡིན།"}, {"label": "QUOTE", "frame": "རྩ་ཤེར།", "head": "བདག་ལས་མ་ཡིན་གཞན་ལས་", "tail": "སྐྱེ་བ་ནམ་ཡང་ཡོད་མ་ཡིན། །\nཞེས་མཐའ་བཞིའི་སྐྱེ་འགོག་གི་"}, {"label": "QUOTE", "frame": "འཕགས་པའི་མཉམ་གཞག་དངོས་པོ་འཇིག་རྒྱུར་གྱི་ཐལ་བ།", "head": "གལ་ཏེ་རང་གི་མཚན་ཉིད་", "t