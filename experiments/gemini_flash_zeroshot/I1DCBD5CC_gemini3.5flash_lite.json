 "head": "རང་གི་ལྟ་ལ་ཆགས་དང་དེ་", "tail": "རྣམ་དཔྱོད་པ་ནི་མྱུར་དུ་གྲོལ་བར་འགྱུར། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "འཇུག་པར།", "head": "བསྟན་བཅོས་ལས་དཔྱད་རྩོད་ལ་", "tail": "གཞན་གཞུང་འཇིག་པར་འགྱུར་ནའང་ཉེས་པ་མེད། །\nཅེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལས།", "head": "མིག་དང་རྣ་བ་སྣ་ཡང་ཚད་", "tail": "འཕགས་པའི་ལམ་གྱིས་སུ་ལ་ཅི་ཞིག་ བགྱི། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "དུས་འཁོར་ལས།", "head": "ཕུང་པོ་རྣམ་དཔྱད་སྟོང་པ་", "tail": "སྟོང་ཉིད་འདི་དང་འདྲ་ མ་ཡིན། །\nཞེས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "བདེན་གཉིས་ལས།", "head": "ཡང་དག་ཉིད་དུ་གཉིས་མེད་", "tail": "རྒྱལ་བའི་སྲས་པོས་མ་གསུངས་བཞུགས། །\nཞེས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "རྗེ་མི་བསྐྱོད་ཞབས་ཀྱིས་གཞན་སྟོང་སྲོལ་འབྱེད་ནང་།", "head": "རང་སྤྱི་གང་དང་མ་འདྲེས་", "tail": "དབྱིངས་ཉིད་དེ་ཉིད་རིག་པས་གང་མཐོང་བ། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "འཇུག་པར།", "head": "འོན་ཀྱང་ཁྱེད་ཀྱི་གསང་བ་", "tail": "བསྙད་བགྱི་མ་ལགས་སོ། །\nཞེས་བདག་མེད་ཀྱིི་"}, {"label": "QUOTE", "frame": "སྡུད་པར།", "head": "ནམ་མཁའ་མཐོང་ཞེས་སེམས་", "tail": "མཐོང་བ་དཔེ་གཞན་གྱིས་ནི་བསྙད་པར་ནུས་མ་ཡིན། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "འཇུག་པར།", "head": "གང་གིས་དངོས་གཅིག་དེ་བཞིན་", "tail": "དེ་ཡིས་དངོས་ཀུན་དེ་བཞིན་ཉིད་ མཐོང་འགྱུར། །\nཅེས་སྣང་ཡུལ་གྱི་"}, {"label": "QUOTE", "frame": "མཻ་ཏྲི་པས།", "head": "རྣམ་རྟོག་རྣམས་ཀྱི་རྩ་བ་", "tail": "སེམས་འདི་བརྟགས་པས་མ་གྲུབ་རང་ལ་ཐིམ། །\nཞེས་གསུངས།"}, {"label": "QUOTE", "frame": "ཕར་ཕྱིན་བསྡུས་པར།", "head": "རྒྱུན་མི་ཆད་པའི་རྣལ་འབྱོར་", "tail": "ཁྱད་པར་མ་ཐོབ་བཏང་མི་བྱ། །\nཞེས་དང་།"}, {"label": "QUOTE", "frame": "སྤྱོད་འཇུག་ལས།", "head": "ཞི་གནས་རབ་ཏུ་ལྡན་པའི་", "tail": "ཉོན་མོངས་རྣམ་པར་འཇོམས་པར་ཤེས་བྱས་ནས། །\nཞེས་བྱ་བ་དང་།"}, {"label": "QUOTE", "frame": "མདོ་སྡུད་པར།", "head": "གང་ཞིག་ཕུང་པོ་ལྔ་དག་", "tail": "འདི་ནི་ཤེས་རབ་ཕ་རོལ་ཕྱིན་མཆོག་སྤྱོད་པ་ཡིན། །\nཞེས་གསུངས་སོ། །"}, {"label": "QUOTE", "frame": "སྤྱོད་འཇުག་ནང་དབེན་པའི་ཡོན་ཏན་བཤད་སྐབས།", "head": "ལུས་འདུ་འཛིས་དབེན་པ་", "tail": "སེམས་རྣམ་རྟོག་གིས་དབེན་པ་གསུངས་པ་དེ་ཡིན།"}, {"label": "QUOTE", "frame": "བཤེས་སྤྲིང་ལས།", "head": "རྒོད་དང་འགྱོད་དང་གནོད་", "tail": "འཕྲོག་པའི་ཆོམ་རྐུན་ལགས་པར་མཁྱེན་པར་མཛོད། །\nཞེས་གསུངས་པ་ལྟར།"}, {"label": "QUOTE", "frame": "བཤེས་སྤྲིང་ལས།", "head": "གང་ཟག་གང་ཞིག་གིས་སྦྲུལ་", "tail": "ཞེས་སྦྲུལ་ཡོད་པར་དྭོགས་པའི་འཇིགས་སྐྲག་འདོར་ནུས་པ་ལས།"}, {"label": "QUOTE", "frame": "རྣམ་སྣང་མངོན་བྱང་གི་རྒྱུད་ཀྱི་ནང་དུ།", "head": "རིགས་ཀྱི་བུའམ་བུ་མོ་གང་", "tail": "རང་གི་སེམས་ཉིད་ཡོངས་སུ་བཙལ་བར་བྱའོ། །\nཞེས་གསུངས།"}]}