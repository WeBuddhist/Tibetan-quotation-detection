venv/
.venv/
*.egg-info/
__pycache__/
*.py[cod]

# Run logs and local eval caches
wandb/
*.eval_cache_val/
outputs/*_logit_cache/

# Third-party checkouts (DharmaBench etc.)
third_party/

# macOS
.DS_Store
